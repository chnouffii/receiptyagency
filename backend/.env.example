# ============================================================
# Receipty Agency — Backend environment variables
# Copy this file to `.env` (same folder) and fill in real values.
#   cp .env.example .env
# NE COMMITEZ JAMAIS le fichier .env réel (il est ignoré par git).
# ============================================================

# --- Base de données MongoDB (OBLIGATOIRE) ---
# URL de connexion. En local : mongodb://localhost:27017
# MongoDB Atlas : mongodb+srv://user:password@cluster.xxxxx.mongodb.net
MONGO_URL=mongodb://localhost:27017

# Nom de la base de données utilisée par l'application.
DB_NAME=receipty

# --- Sécurité JWT (OBLIGATOIRE) ---
# Clé secrète utilisée pour signer les tokens d'authentification.
# Générez une valeur aléatoire forte, ex :
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Changez-la = déconnecte toutes les sessions existantes.
JWT_SECRET=changez-moi-avec-une-cle-aleatoire-longue

# --- CORS (recommandé en production) ---
# Domaines autorisés à appeler l'API, séparés par des virgules.
# Si vide, toutes les origines sont acceptées (à éviter en prod).
CORS_ORIGINS=https://receipty.fr,https://www.receipty.fr

# --- Frontend (utilisé au build par docker-compose) ---
# URL publique de l'API, injectée dans le build React (REACT_APP_BACKEND_URL).
# Ex : https://receipty.fr  (le frontend appellera alors https://receipty.fr/api)
REACT_APP_BACKEND_URL=https://receipty.fr

# --- Emails transactionnels (optionnel) ---
# Clé API Resend pour l'envoi des notifications de contact.
# Si absent, les emails sont simplement ignorés (le reste fonctionne).
RESEND_API_KEY=
# Adresse qui reçoit les notifications des formulaires de contact.
NOTIFICATION_EMAIL=contact@receipty.fr

# --- Assistant IA / Chatbot (optionnel) ---
# Clé API Anthropic utilisée par utils/llm.py (via litellm) pour le chat,
# les résumés d'appels et les rapports d'audit. Format : sk-ant-...
# Si absente, le chatbot renvoie un message d'erreur générique.
ANTHROPIC_API_KEY=
# Ancienne clé Emergent — conservée pour compatibilité, non utilisée par
# utils/llm.py. Peut rester vide.
EMERGENT_LLM_KEY=

# ============================================================
# Note : le compte admin par défaut (admin@receipty.ai) est créé
# automatiquement au premier démarrage si la collection `admins`
# est vide — le mot de passe généré est affiché UNE FOIS dans les logs.
# Pour (ré)initialiser un accès : python reset_admin_password.py
#
# ADMIN_EMAIL / ADMIN_PASSWORD peuvent être définis pour piloter
# reset_admin_password.py sans arguments (utile en CI). Non requis
# pour le fonctionnement de l'application.
# ============================================================
